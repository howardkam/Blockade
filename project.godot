config_version=5

[application]

config/name="Blockade"
run/main_scene="uid://bqxgmv5ksdhxw"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://b1rjcu0akdi2i"
config/windows_native_icon="res://Assets/blockade.ico"

[autoload]

SceneManager="*uid://j20v4cg7v8m1"
Global="*uid://bcmth6uh8hnll"
MusicManager="*uid://cb4jlsj5bnhuj"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/scene_manager/plugin.cfg")

[global_group]

enemy=""
player=""
enemy_explosion_sounds=""
obstacles=""

